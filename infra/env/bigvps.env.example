# Copy to <DEPLOY_PATH>/shared/.env on BIGVPS; never commit the real file.
# PostgreSQL password must match in both values. URL-encode it in DATABASE_URL.
POSTGRES_DB=portfolio
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://portfolio:replace-with-a-long-random-password@db:5432/portfolio

# Staging values. For production use https://selickiy.space in both URL values.
NEXTAUTH_URL=https://staging.selickiy.space
NEXT_PUBLIC_SITE_URL=https://staging.selickiy.space
NEXTAUTH_SECRET=replace-with-a-long-random-value
GOOGLE_CLIENT_ID=replace-me
GOOGLE_CLIENT_SECRET=replace-me
ADMIN_EMAILS=admin@example.com

# Staging router. Production: Host(`selickiy.space`,`www.selickiy.space`)
TRAEFIK_ROUTER_NAME=selickiy-landing
TRAEFIK_RULE=Host(`staging.selickiy.space`)
TRAEFIK_ENTRYPOINT=websecure
